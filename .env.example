# Copy to `.env` and change the password. `.env` is ignored by git and Docker.
#
# POSTGRES_PASSWORD is the only secret in stage 01. It is used by the
# PostgreSQL container and by the API to reach it inside the Compose network.

POSTGRES_PASSWORD=change-me-before-first-start

# Host port the API is published on (127.0.0.1 only).
MTL_HORIZON_API_PORT=8000

# Stellar network the database belongs to. The database is created for the
# public network; the API refuses to work with it when this differs, so
# uncommenting this line requires a database created for that network.
# MTL_HORIZON_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Where history is read from, and how fast this installation may ask. The
# public server publishes no limit; keep to one or two requests per second.
MTL_HORIZON_URL=https://horizon.stellar.org
MTL_HORIZON_REQUESTS_PER_SECOND=1
MTL_HORIZON_CONCURRENCY=1

# Live collection (`python -m app.collector run`): one cycle every so many
# seconds, and what one cycle may cost at most. The time budget is nine
# tenths of the interval when not set.
MTL_HORIZON_COLLECTOR_INTERVAL=900
# MTL_HORIZON_COLLECTOR_MAX_REQUESTS=2000
# MTL_HORIZON_COLLECTOR_MAX_SECONDS=810
