# Copy to `.env` and change the password. `.env` is ignored by git and Docker.
#
# POSTGRES_PASSWORD is the only secret here. It is used by the PostgreSQL
# container and by the services to reach it inside the Compose network. The
# Notifier's key below is a public key, not a secret.

POSTGRES_PASSWORD=change-me-before-first-start

# Host port the API is published on (127.0.0.1 only).
MTL_HORIZON_API_PORT=8000

# Stellar network the database belongs to. The database is created for the
# public network; the API refuses to work with it when this differs, so
# uncommenting this line requires a database created for that network.
# MTL_HORIZON_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Where history is read from, and how fast this installation may ask — every
# process together (worker, backfill, collector, checks), whichever server
# answers: more servers do not make it faster. The public server publishes no
# limit; keep to one or two requests per second.
MTL_HORIZON_URL=https://horizon.stellar.org
MTL_HORIZON_REQUESTS_PER_SECOND=1
MTL_HORIZON_CONCURRENCY=1

# Several servers, the first being the primary. The next one is asked when
# the one before it fails, and the first again once it has cooled down. The
# example below names no real server. MTL_HORIZON_URL may stay next to it
# when it names the primary.
# MTL_HORIZON_URLS=https://horizon.stellar.org,https://your-horizon.example.org
# How long what a server said of itself (its network, its oldest and newest
# ledger) is trusted before it is asked again, in seconds.
MTL_HORIZON_HEALTH_CHECK_INTERVAL=300
# How long a server that did not answer is left alone, in seconds. It doubles
# each time the server fails again in a row.
MTL_HORIZON_FAILOVER_COOLDOWN=60

# The keys Operations Notifier signs its webhooks with, as Stellar public
# keys (what the Notifier's own /api/status shows as publicKey), separated by
# commas. With none set the webhook at /webhooks/notifier accepts nothing.
# MTL_HORIZON_NOTIFIER_KEYS=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Polling collection (`python -m app.collector run`) is for recovery and
# control reads only: history comes in as the worker handles notifications.
# One cycle every so many seconds, and what one cycle may cost at most. The
# time budget is nine tenths of the interval when not set.
MTL_HORIZON_COLLECTOR_INTERVAL=900
# MTL_HORIZON_COLLECTOR_MAX_REQUESTS=2000
# MTL_HORIZON_COLLECTOR_MAX_SECONDS=810
